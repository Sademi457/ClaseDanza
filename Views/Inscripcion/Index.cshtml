@model EscuelaDanzaMVC.Models.Inscripcion

@{
    ViewData["Title"] = "Inscripción";
}

<section class="container my-5">

    <div class="formulario p-4 mx-auto" style="max-width: 600px;">

        <h2 class="text-center mb-4">Inscríbete a una clase</h2>

        <form asp-controller="Inscripcion"
              asp-action="Index"
              method="post">

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">
                    Nombre del estudiante
                </label>

                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Escribe tu nombre">

                <span asp-validation-for="Nombre"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Clase" class="form-label">
                    Selecciona una clase
                </label>

                <select asp-for="Clase" class="form-select">

                    <option value="">Elige una opción</option>

                    <option value="Ballet">Ballet</option>

                    <option value="Salsa">Salsa</option>

                    <option value="Danza contemporánea">
                        Danza contemporánea
                    </option>

                </select>

                <span asp-validation-for="Clase"
                      class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-principal">
                    Inscribirme
                </button>
            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}